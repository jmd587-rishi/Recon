# =============================================================================
# Recon Server - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Server
PORT=4000

# =============================================================================
# Azure AI Foundry / Azure OpenAI (used for LLM-based notebook code analysis)
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-foundry.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployed-model-name

# Default ceiling for one LLM call, in ms. Callers that fan out many small calls override it.
# AZURE_OPENAI_TIMEOUT_MS=120000

# Only set this on a REASONING deployment (o-series, gpt-5-class) — a non-reasoning deployment
# rejects the parameter outright. `low` is the single biggest latency win for the L4
# reconciliation-script flow, which is grounded extraction rather than open-ended reasoning.
# AZURE_OPENAI_REASONING_EFFORT=low

# =============================================================================
# L4 reconciliation scripts (/api/local/reconciliation) — tune if the model is slow
# =============================================================================
# Target tables per call. Lower = shorter answers = faster, at more calls.
# RECON_TARGETS_PER_CALL=2
# Calls in flight at once. The whole suite should cost about one call's wall-clock.
# RECON_CONCURRENCY=4
# Per-call ceiling in ms. A call that overruns degrades to the derived checks; it never hangs.
# RECON_LLM_TIMEOUT_MS=75000
# Output-token budget per target table.
# RECON_MAX_OUTPUT_TOKENS=1600
