# =============================================================================
# Recon Server - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Server
PORT=4000

# =============================================================================
# Azure AI Foundry / Azure OpenAI (used for LLM-based notebook code analysis)
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-foundry.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployed-model-name

# Default ceiling for one LLM call, in ms. Callers that fan out many small calls override it.
# AZURE_OPENAI_TIMEOUT_MS=120000

# Only set this on a REASONING deployment (o-series, gpt-5-class) — a non-reasoning deployment
# rejects the parameter outright. `low` is the single biggest latency win for the L4
# reconciliation-script flow, which is grounded extraction rather than open-ended reasoning.
# AZURE_OPENAI_REASONING_EFFORT=low

# =============================================================================
# L4 reconciliation scripts (/api/local/reconciliation) — tune if the model is slow
# =============================================================================
# The defaults below favour accuracy over speed: whole transformations go to the model rather than
# truncated ones, and a failed call is retried rather than quietly costing that table its checks.
# Lower them only if you would rather have a faster, thinner suite.
#
# Target tables per call. One keeps each prompt to a single table's lineage neighbourhood; raising
# it puts unrelated tables in one prompt, sharing the budget between them.
# RECON_TARGETS_PER_CALL=1
# Calls in flight at once. Lower this if the endpoint starts rate-limiting.
# RECON_CONCURRENCY=4
# Per-call ceiling in ms. Generous, because the prompts are large.
# RECON_LLM_TIMEOUT_MS=240000
# Attempts after the first, with backoff, for a call that times out or is rate-limited.
# RECON_RETRIES=3
# RECON_RETRY_BACKOFF_MS=2000
# Output-token budget per target table.
# RECON_MAX_OUTPUT_TOKENS=6000
# Pipeline-specific checks asked for per table.
# RECON_CHECKS_PER_TARGET=6
#
# How much code the model is shown. The defaults fit a real warehouse's largest transformation whole
# (measured: 13 KB largest statement, 25 KB largest target, 37 KB of upstream chain). A check written
# against half a procedure is a guess about the half the model could not see — raise these rather
# than let a transformation be truncated.
# Cap on any one statement.
# RECON_SQL_CHARS_PER_STATEMENT=20000
# Budget for the statements that build the target itself.
# RECON_SQL_CHARS_PER_TARGET=40000
# Separate budget for the upstream chain, so context can't crowd out the code under review.
# RECON_UPSTREAM_CHARS=50000
# How far up the lineage the context reaches. 3 spans raw -> stage -> transformation -> mart.
# RECON_UPSTREAM_HOPS=3
# Columns listed per table before the list is cut.
# RECON_MAX_COLUMNS_LISTED=400
